# Server runtime env. Copy to `.env` (gitignored) and edit.
#
# Quick start (local dev — no env file needed):
#   cd server && docker compose up -d db
#   cd server && .\gradlew.bat bootRun
# The default Spring profile is `local`, which reads application-local.yml
# and points at the docker-compose Postgres on localhost:5432.
#
# Use this file when you want to override the default (e.g. point at the
# remote PostgreSQL 18 at 192.168.80.152). Then boot with:
#   set -a; source .env; set +a; ./gradlew bootRun
#   (or use direnv / dotenv / your shell of choice)
# `local` stays the active profile, but the env vars below override the
# URL/username/password that application-local.yml would otherwise provide
# because OS env vars have higher precedence than profile yml.

# --- Profile ---
# Set to `prod` for deployment. Leave unset (or `local`) for dev.
# SPRING_PROFILES_ACTIVE=prod

# --- Datasource (override the local docker-compose defaults) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.80.152:5432/quote_garden
# SPRING_DATASOURCE_USERNAME=quotegarden
# SPRING_DATASOURCE_PASSWORD=changeme

# --- HTTP ---
# SERVER_PORT=8080
